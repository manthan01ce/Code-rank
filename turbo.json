{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "CODERANK_PUBLIC_URL",
        "CODERANK_ALLOW_INDEXING",
        "CODERANK_SUPPORT_EMAIL",
        "CODERANK_SUPPORT_URL",
        "VERCEL_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "start": {
      "cache": false
    }
  }
}
