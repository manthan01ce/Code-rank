{
  "name": "coderank-monorepo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "node --env-file-if-exists=.env --test tests/*.test.js",
    "worker": "npm run dev --workspace=apps/worker",
    "web": "npm run dev --workspace=apps/web",
    "db:migrate": "node packages/core/src/db/migrate.js",
    "k6:smoke": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test smoke",
    "k6:smoke-100": "k6 run -e BASE_URL=http://localhost:3000 ./load-tests/smoke-test-100vu.js",
    "k6:stress": "k6 run -e BASE_URL=http://localhost:3000 ./load-tests/stress-test.js",
    "k6:api": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test api",
    "k6:execution": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test execution",
    "k6:all": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test all",
    "k6:qualify:smoke": "k6 run -e MODE=smoke load-tests/qualification.js",
    "k6:qualify:api": "k6 run -e MODE=api load-tests/qualification.js",
    "k6:qualify:run": "k6 run -e MODE=run load-tests/qualification.js",
    "k6:qualify:submission": "k6 run -e MODE=submission load-tests/qualification.js",
    "k6:qualify:concurrency": "k6 run -e MODE=concurrency load-tests/qualification.js"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@11.11.0"
}
