{
  "name": "coderank-monorepo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev/dev-stack.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "worker": "npm run dev --workspace=apps/worker",
    "web": "node scripts/dev/web-runtime.mjs",
    "api": "npm run dev --workspace=apps/api",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml --profile local-database up -d",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml --profile local-database down",
    "infra:build:sandbox": "docker compose --env-file .env -f infrastructure/docker-compose.yml --profile build-image build runner-image",
    "k6:smoke": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test smoke",
    "k6:smoke-100": "k6 run -e BASE_URL=http://localhost:3000 ./load-tests/smoke-test-100vu.js",
    "k6:stress": "k6 run -e BASE_URL=http://localhost:3000 ./load-tests/stress-test.js",
    "k6:api": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test api",
    "k6:execution": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test execution",
    "k6:all": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test all",
    "test": "node scripts/ci/run-tests.mjs unit",
    "db:migrate": "node database/run-migration.js",
    "db:seed": "node database/seed.js",
    "test:redis": "node --test tests/integration/queue.test.mjs tests/integration/realtime.test.mjs tests/integration/worker-readiness.test.mjs tests/integration/worker-recovery.test.mjs",
    "test:postgres": "node --test tests/integration/postgres.test.mjs",
    "test:docker": "node scripts/ci/run-tests.mjs docker",
    "db:preflight": "node database/preflight.js",
    "test:neon": "node --test tests/integration/neon.test.mjs tests/integration/neon-upgrade.test.mjs",
    "test:stack": "node scripts/stack-smoke.mjs",
    "deployment:check": "node scripts/check-deployment.mjs",
    "db:manifest": "node database/update-readiness-manifest.js",
    "test:integration": "node scripts/ci/run-tests.mjs integration",
    "test:authenticated": "node scripts/authenticated-stack.mjs",
    "lint:critical": "eslint --config tooling/eslint.config.mjs packages/core packages/database packages/queue packages/runner apps/api apps/worker scripts apps/web/src/lib infrastructure/gateway --max-warnings=0 load-tests/capacity.mjs apps/web/src/features/practicals/hooks/usePracticalPage.js apps/web/src/features/reports/components/PracticalGradeReport.js apps/web/src/features/reports/hooks/usePracticalGradeReport.js \"apps/web/src/app/student/code/**/WorkspaceClientWrapper.js\"",
    "db:operations": "node scripts/database-ops.mjs",
    "test:capacity": "node load-tests/capacity.mjs",
    "runner:reap": "node scripts/reap-sandboxes.mjs",
    "k6:qualify:smoke": "k6 run -e MODE=smoke load-tests/qualification.js",
    "k6:qualify:api": "k6 run -e MODE=api load-tests/qualification.js",
    "k6:qualify:run": "k6 run -e MODE=run load-tests/qualification.js",
    "k6:qualify:submission": "k6 run -e MODE=submission load-tests/qualification.js",
    "k6:qualify:concurrency": "k6 run -e MODE=concurrency load-tests/qualification.js",
    "retention": "node scripts/retention.mjs",
    "web:production": "node scripts/dev/web-runtime.mjs --production",
    "test:faculty-review": "playwright test --config tests/browser/faculty-review.config.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "globals": "14.0.0",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "turbo": "^2.5.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.11.0"
}
