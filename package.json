{
  "name": "coderank-monorepo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "worker": "npm run dev --workspace=apps/worker",
    "web": "npm run dev --workspace=apps/web",
    "k6:smoke": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test smoke",
    "k6:smoke-100": "k6 run -e BASE_URL=http://localhost:3000 ./load-tests/smoke-test-100vu.js",
    "k6:stress": "k6 run -e BASE_URL=http://localhost:3000 ./load-tests/stress-test.js",
    "k6:api": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test api",
    "k6:execution": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test execution",
    "k6:all": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-k6.ps1 -Test all",
    "test": "node scripts/ci/run-tests.mjs unit",
    "db:migrate": "node database/run-migration.js",
    "test:redis": "node --test tests/integration/queue.test.mjs tests/integration/realtime.test.mjs tests/integration/worker-readiness.test.mjs tests/integration/worker-recovery.test.mjs",
    "test:postgres": "node --test tests/integration/postgres.test.mjs",
    "test:docker": "node scripts/ci/run-tests.mjs docker",
    "db:preflight": "node database/preflight.js",
    "test:neon": "node --test tests/integration/neon.test.mjs tests/integration/neon-upgrade.test.mjs",
    "test:stack": "node scripts/stack-smoke.mjs",
    "deployment:check": "node scripts/check-deployment.mjs",
    "db:manifest": "node database/update-readiness-manifest.js",
    "test:integration": "node scripts/ci/run-tests.mjs integration",
    "test:authenticated": "node scripts/authenticated-stack.mjs",
    "lint:critical": "eslint --config apps/web/eslint.config.mjs packages/core packages/database packages/queue packages/runner apps/worker scripts apps/web/src/app/api apps/web/src/lib apps/web/server.js apps/web/cluster.js --max-warnings=0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.56.1",
    "pg": "8.23.1",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.11.0"
}
