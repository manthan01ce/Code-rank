{
  "name": "coderank-monorepo",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "worker": "npm run dev --workspace=apps/worker",
    "web": "npm run dev --workspace=apps/web"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@11.11.0"
}
