# CodeRank Environment Variables Template
# Copy this file to .env and replace the values with your actual configuration.

# ---------------------------------------------------------
# Database (Neon Serverless Postgres / PgBouncer)
# ---------------------------------------------------------
# Standard Neon direct connection:
# DATABASE_URL=postgresql://your_db_owner:YOUR_PASSWORD@ep-your-database-id.us-east-1.aws.neon.tech/neondb?sslmode=require
#
# Neon PgBouncer Connection Pooler (recommended for high concurrency):
DATABASE_URL=postgresql://your_db_owner:YOUR_PASSWORD@ep-your-database-id-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1

# ---------------------------------------------------------
# Authentication / Security
# ---------------------------------------------------------
# Secure JWT secret key for signing user sessions
JWT_SECRET=your_super_secret_jwt_key_here

# ---------------------------------------------------------
# Admin Fallback Credentials
# ---------------------------------------------------------
# Default admin account to use if DB admin user is not set up
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword123

# ---------------------------------------------------------
# Backend Worker & Redis (BullMQ Queue)
# ---------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------------------------------------------------------
# Server configuration
# ---------------------------------------------------------
ALLOWED_ORIGIN=http://localhost:3000

# ---------------------------------------------------------
# Job Queue Limits
# ---------------------------------------------------------
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MS=30000
MAX_QUEUE_SIZE=500

# ---------------------------------------------------------
# Rate Limiting (Requests per window)
# ---------------------------------------------------------
RATE_LIMIT_SUBMIT=5
RATE_LIMIT_RUN=15
RATE_LIMIT_LOGIN=5
RATE_LIMIT_DEFAULT=60
