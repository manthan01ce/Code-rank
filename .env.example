# CodeRank Environment Variables Template
# Copy this file to .env and replace the values with your actual configuration.
# Backend configuration belongs to API/worker; standard Next.js receives only frontend/runtime settings.
# Private API listener (independent of web PORT); restart processes after changes.
API_PORT=3001
API_HOST=127.0.0.1
# INTERNAL_API_URL=http://127.0.0.1:3001  # omit to derive from API_PORT in lab launchers

# ---------------------------------------------------------
# Database (Local PostgreSQL or Neon Serverless)
# ---------------------------------------------------------
# For Local PostgreSQL (recommended for local development):
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coderank_local?sslmode=disable
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coderank_test?sslmode=disable

# For Neon Serverless Postgres:
# DATABASE_DRIVER=neon
# DATABASE_URL=postgresql://your_db_owner:YOUR_PASSWORD@ep-your-database-id-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1

# Database connection pool size (default: 10, recommended for production scale: 25)
DB_POOL_SIZE=25

# ---------------------------------------------------------
# Authentication / Security
# ---------------------------------------------------------
# Secure JWT secret key for signing user sessions
JWT_SECRET=your_super_secret_jwt_key_here

# ---------------------------------------------------------
# Admin Fallback Credentials
# ---------------------------------------------------------
# Default admin account to use if DB admin user is not set up
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword123

# ---------------------------------------------------------
# Backend Worker & Redis (BullMQ Queue)
# ---------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------------------------------------------------------
# Server configuration
# ---------------------------------------------------------
# Documented default port: 3000.  Both launchers and server.js
# fall back to this value.  Override PORT in your .env or
# environment to change it; launchers and REALTIME_URL will
# follow automatically unless an explicit REALTIME_URL is set.
#
# ALLOWED_ORIGIN: comma-separated browser origins for CORS;
#   launchers derive from the effective PORT if unset.
# REALTIME_URL: worker/API internal Socket.IO address;
#   derived from PORT when absent.
# NEXT_PUBLIC_REALTIME_URL: optional separate browser
#   realtime origin; leave unset for same-origin (default).
#   This is a Next.js build-time variable: changing it
#   requires a rebuild to take effect in the browser bundle.
# ALLOWED_ORIGIN=http://localhost:3000
PORT=3000

# ---------------------------------------------------------
# Job Queue Limits
# ---------------------------------------------------------
# Concurrency of independent per-job Docker sandboxes
# Warm daemons are retired: remove USE_WARM_DAEMONS from existing environments.
MAX_CONCURRENT_JOBS=16
# Set to true only while debugging; per-job console output adds avoidable load.
WORKER_VERBOSE_LOGS=false
# Maximum time to drain active jobs during SIGTERM/SIGINT before forced exit.
SHUTDOWN_GRACE_MS=45000
JOB_TIMEOUT_MS=30000
MAX_QUEUE_SIZE=500
MAX_JOBS_PER_USER=150
RUNNER_IMAGE=coderank-base:latest

# ---------------------------------------------------------
# Rate Limiting (Requests per window)
# ---------------------------------------------------------
RATE_LIMIT_SUBMIT=500
RATE_LIMIT_RUN=1000
RATE_LIMIT_LOGIN=100
RATE_LIMIT_DEFAULT=30000

# Worker/API relay destination; defaults to API service (http://127.0.0.1:3001).
# Set explicitly only when the realtime server runs on a different address.
# REALTIME_URL=http://127.0.0.1:3001

# Optional separate realtime origin for browsers (build-time variable).
# Leave unset for same-origin; changing requires a rebuild.
# NEXT_PUBLIC_REALTIME_URL=https://realtime.example.com

# Enable shared realtime when running multiple API/realtime instances.
# Frontend replica management is independent of the API Redis adapter.
REALTIME_REDIS_ENABLED=false
CLUSTER_ENABLED=false
WEB_CONCURRENCY=2
# Host supervisor derives private Next.js ports from PORT+20 by default.
# WEB_INTERNAL_PORT=3020

# Unique per deployment sharing a Docker host; identical for its worker replicas.
SANDBOX_SCOPE=coderank

# ---------------------------------------------------------
# Caching Configuration
# ---------------------------------------------------------
# Set to true ONLY during isolated raw database load testing.
# Keep false (caching enabled) for normal development and production.
DISABLE_CACHE=false

# Canonical Compose volume identity. Defaults retain the old infrastructure project.
# Before moving an EXISTING root-Compose installation, inspect its container mounts
# and set these to the actual old named volumes. Never reset/prune data volumes.
CODERANK_REDIS_VOLUME=infrastructure_redis_data
CODERANK_POSTGRES_VOLUME=infrastructure_postgres_data

# Public-site presentation (set in the WEB build environment, then rebuild).
# Leave indexing disabled for lab, staging and preview deployments.
CODERANK_PUBLIC_URL=
CODERANK_ALLOW_INDEXING=false
# Institution-approved public contacts only. Leave blank to use faculty/admin guidance.
CODERANK_SUPPORT_EMAIL=
CODERANK_SUPPORT_URL=

# Independent analytics access: backend only. Never use NEXT_PUBLIC_ for these.
# Generate a new hash and secret with npm run analytics:setup (interactive).
ANALYTICS_PASSWORD_HASH=
ANALYTICS_SESSION_SECRET=
# Exact browser origin, HTTPS except localhost development.
ANALYTICS_ORIGIN=
